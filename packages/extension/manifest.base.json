{
  "manifest_version": 3,
  "name": "FlowForge for Google Flow",
  "short_name": "FlowForge",
  "description": "Queues, workflows, storyboards and downloads for Google Flow. Independent tool, not affiliated with Google.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Open FlowForge" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "downloads", "tabs", "scripting", "alarms", "notifications"],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://flow-content.google/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*", "https://labs.google/fx/*"],
      "js": ["picker-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://flow.google.com/*", "https://labs.google/fx/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: ws://127.0.0.1:*"
  }
}
